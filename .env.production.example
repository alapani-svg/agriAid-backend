# Production environment template.
# Copy to `.env`, fill in every value marked CHANGE_ME, then run:
#   php artisan key:generate
# NEVER commit the resulting .env file.

APP_NAME=agriAid
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com
FRONTEND_URL=https://CHANGE_ME-frontend.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agriaid
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

BROADCAST_DRIVER=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to your apex domain (e.g. .agriaid.com) so the API and frontend can share the Sanctum session cookie.
SESSION_DOMAIN=CHANGE_ME
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# Comma-separated list of frontend origins allowed to authenticate via Sanctum's stateful/cookie guard.
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME-frontend.example.com

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@agriaid.com"
MAIL_FROM_NAME="${APP_NAME}"

# Docker/entrypoint controls (see docker/php/entrypoint.sh)
RUN_MIGRATIONS=1

# Used by HarvestPhotoVerificationService to AI-verify harvest photos against declared quantities.
# Leave blank to disable photo verification (harvests are simply recorded with verification_status=unavailable).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
